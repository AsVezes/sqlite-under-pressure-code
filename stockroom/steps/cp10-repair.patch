+class RestoreFutureBoundaryTests(unittest.TestCase):
+    def test_future_receipt_boundary_refused_without_selection(self):
+        with TemporaryDirectory() as temp:
+            root = Path(temp)
+            live = ready(root)
+            baseline = validate(live)
+            future = root / "future.db"
